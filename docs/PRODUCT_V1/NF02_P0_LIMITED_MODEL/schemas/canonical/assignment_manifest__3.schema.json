{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bdb:p0:canonical:assignment_manifest/3",
  "type": "object",
  "properties": {
    "object_id": {
      "allOf": [
        {
          "$ref": "urn:bdb:p0:wire:COMMON/1#/$defs/LogicalId"
        },
        {
          "pattern": "^assignment_manifest_"
        }
      ]
    },
    "model_id": {
      "const": "BDB_NF02_P0_LIMITED_1"
    },
    "campaign_ref": {
      "allOf": [
        {
          "$ref": "urn:bdb:p0:wire:COMMON/1#/$defs/TypedRef"
        },
        {
          "properties": {
            "kind": {
              "enum": [
                "campaign_genesis"
              ]
            }
          }
        }
      ]
    },
    "source_ref": {
      "allOf": [
        {
          "$ref": "urn:bdb:p0:wire:COMMON/1#/$defs/TypedRef"
        },
        {
          "properties": {
            "kind": {
              "enum": [
                "nf02_p0_source_snapshot"
              ]
            }
          }
        }
      ]
    },
    "attempt_ref": {
      "allOf": [
        {
          "$ref": "urn:bdb:p0:wire:COMMON/1#/$defs/TypedRef"
        },
        {
          "properties": {
            "kind": {
              "enum": [
                "attempt"
              ]
            }
          }
        }
      ]
    },
    "assignment_cut": {
      "$ref": "urn:bdb:p0:wire:COMMON/1#/$defs/HistoryCut"
    },
    "auditor_certificate_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "task_raw_ref": {
      "allOf": [
        {
          "$ref": "urn:bdb:p0:wire:COMMON/1#/$defs/RawRef"
        },
        {
          "properties": {
            "media_type": {
              "const": "text/markdown"
            },
            "artifact_contract_ref": {
              "allOf": [
                {
                  "$ref": "urn:bdb:p0:wire:COMMON/1#/$defs/ProfileRef"
                },
                {
                  "properties": {
                    "profile_id": {
                      "const": "P0_PACKAGE_TRANSPORT_V1"
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "input_members": {
      "type": "array",
      "items": {
        "$ref": "urn:bdb:p0:wire:COMMON/1#/$defs/Member"
      },
      "minItems": 1,
      "maxItems": 4096,
      "uniqueItems": true
    },
    "result_slot_id": {
      "const": "EXTERNAL_AUDIT_RESULT"
    },
    "package_profile_ref": {
      "allOf": [
        {
          "$ref": "urn:bdb:p0:wire:COMMON/1#/$defs/ProfileRef"
        },
        {
          "properties": {
            "profile_id": {
              "const": "P0_PACKAGE_TRANSPORT_V1"
            }
          }
        }
      ]
    },
    "result_profile_ref": {
      "allOf": [
        {
          "$ref": "urn:bdb:p0:wire:COMMON/1#/$defs/ProfileRef"
        },
        {
          "properties": {
            "profile_id": {
              "const": "P0_RESULT_TRANSPORT_V1"
            }
          }
        }
      ]
    },
    "isolation_profile_ref": {
      "allOf": [
        {
          "$ref": "urn:bdb:p0:wire:COMMON/1#/$defs/ProfileRef"
        },
        {
          "properties": {
            "profile_id": {
              "const": "P0_EXECUTION_ISOLATION_V1"
            }
          }
        }
      ]
    }
  },
  "required": [
    "assignment_cut",
    "attempt_ref",
    "auditor_certificate_sha256",
    "campaign_ref",
    "input_members",
    "isolation_profile_ref",
    "model_id",
    "object_id",
    "package_profile_ref",
    "result_profile_ref",
    "result_slot_id",
    "source_ref",
    "task_raw_ref"
  ],
  "additionalProperties": false
}
