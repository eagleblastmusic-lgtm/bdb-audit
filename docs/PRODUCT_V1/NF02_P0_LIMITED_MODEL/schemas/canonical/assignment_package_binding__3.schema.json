{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bdb:p0:canonical:assignment_package_binding/3",
  "type": "object",
  "properties": {
    "object_id": {
      "allOf": [
        {
          "$ref": "urn:bdb:p0:wire:COMMON/1#/$defs/LogicalId"
        },
        {
          "pattern": "^assignment_package_binding_"
        }
      ]
    },
    "model_id": {
      "const": "BDB_NF02_P0_LIMITED_1"
    },
    "assignment_ref": {
      "allOf": [
        {
          "$ref": "urn:bdb:p0:wire:COMMON/1#/$defs/TypedRef"
        },
        {
          "properties": {
            "kind": {
              "enum": [
                "assignment_manifest"
              ]
            }
          }
        }
      ]
    },
    "binding_cut": {
      "$ref": "urn:bdb:p0:wire:COMMON/1#/$defs/HistoryCut"
    },
    "package_raw_ref": {
      "allOf": [
        {
          "$ref": "urn:bdb:p0:wire:COMMON/1#/$defs/RawRef"
        },
        {
          "properties": {
            "media_type": {
              "const": "application/zip"
            },
            "artifact_contract_ref": {
              "allOf": [
                {
                  "$ref": "urn:bdb:p0:wire:COMMON/1#/$defs/ProfileRef"
                },
                {
                  "properties": {
                    "profile_id": {
                      "const": "P0_PACKAGE_TRANSPORT_V1"
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    }
  },
  "required": [
    "assignment_ref",
    "binding_cut",
    "model_id",
    "object_id",
    "package_raw_ref"
  ],
  "additionalProperties": false
}
