{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bdb:p0:canonical:campaign_genesis/3",
  "type": "object",
  "properties": {
    "object_id": {
      "allOf": [
        {
          "$ref": "urn:bdb:p0:wire:COMMON/1#/$defs/LogicalId"
        },
        {
          "pattern": "^campaign_genesis_"
        }
      ]
    },
    "model_id": {
      "const": "BDB_NF02_P0_LIMITED_1"
    },
    "campaign_id": {
      "$ref": "urn:bdb:p0:wire:COMMON/1#/$defs/LogicalId"
    },
    "mode": {
      "enum": [
        "QUALIFICATION_ONLY",
        "PRODUCTION"
      ]
    },
    "task_raw_ref": {
      "allOf": [
        {
          "$ref": "urn:bdb:p0:wire:COMMON/1#/$defs/RawRef"
        },
        {
          "properties": {
            "media_type": {
              "const": "text/markdown"
            },
            "artifact_contract_ref": {
              "allOf": [
                {
                  "$ref": "urn:bdb:p0:wire:COMMON/1#/$defs/ProfileRef"
                },
                {
                  "properties": {
                    "profile_id": {
                      "const": "P0_PACKAGE_TRANSPORT_V1"
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "installation_ref": {
      "allOf": [
        {
          "$ref": "urn:bdb:p0:wire:COMMON/1#/$defs/TypedRef"
        },
        {
          "properties": {
            "kind": {
              "enum": [
                "installation_bootstrap_profile"
              ]
            }
          }
        }
      ]
    },
    "source_ref": {
      "allOf": [
        {
          "$ref": "urn:bdb:p0:wire:COMMON/1#/$defs/TypedRef"
        },
        {
          "properties": {
            "kind": {
              "enum": [
                "nf02_p0_source_snapshot"
              ]
            }
          }
        }
      ]
    },
    "namespace_authority_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "campaign_id",
    "installation_ref",
    "mode",
    "model_id",
    "namespace_authority_digest",
    "object_id",
    "source_ref",
    "task_raw_ref"
  ],
  "additionalProperties": false
}
