{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bdb:p0:external:OWNER_MODEL_DECISION/1",
  "type": "object",
  "properties": {
    "candidate_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "normative_set_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "machine_set_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "scope_graph_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "owner_actor_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "decision": {
      "const": "APPROVE_LIMITED_P0_MODEL"
    },
    "accepted_limits": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "minItems": 1,
      "maxItems": 4096,
      "uniqueItems": true
    }
  },
  "required": [
    "accepted_limits",
    "candidate_manifest_sha256",
    "decision",
    "machine_set_sha256",
    "normative_set_sha256",
    "owner_actor_ref",
    "scope_graph_sha256"
  ],
  "additionalProperties": false
}
