{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bdb:p0:wire:NORMALIZED_RESULT/1",
  "type": "object",
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "finding_id": {
            "$ref": "urn:bdb:p0:wire:COMMON/1#/$defs/LogicalId"
          },
          "severity": {
            "enum": [
              "INFO",
              "LOW",
              "MEDIUM",
              "HIGH",
              "CRITICAL"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "details": {
            "type": "string",
            "maxLength": 65536
          },
          "source_paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "minItems": 0,
            "maxItems": 4096,
            "uniqueItems": true
          },
          "evidence_paths": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 512,
              "pattern": "^[A-Za-z0-9_-]+(?:[.][A-Za-z0-9_-]+)*(?:/[A-Za-z0-9_-]+(?:[.][A-Za-z0-9_-]+)*)*$"
            },
            "minItems": 0,
            "maxItems": 4096,
            "uniqueItems": true
          }
        },
        "required": [
          "details",
          "evidence_paths",
          "finding_id",
          "severity",
          "source_paths",
          "summary"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 4096,
      "uniqueItems": true
    },
    "report_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 512,
        "pattern": "^[A-Za-z0-9_-]+(?:[.][A-Za-z0-9_-]+)*(?:/[A-Za-z0-9_-]+(?:[.][A-Za-z0-9_-]+)*)*$"
      },
      "minItems": 1,
      "maxItems": 4096,
      "uniqueItems": true
    },
    "evidence_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 512,
        "pattern": "^[A-Za-z0-9_-]+(?:[.][A-Za-z0-9_-]+)*(?:/[A-Za-z0-9_-]+(?:[.][A-Za-z0-9_-]+)*)*$"
      },
      "minItems": 0,
      "maxItems": 4096,
      "uniqueItems": true
    },
    "log_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 512,
        "pattern": "^[A-Za-z0-9_-]+(?:[.][A-Za-z0-9_-]+)*(?:/[A-Za-z0-9_-]+(?:[.][A-Za-z0-9_-]+)*)*$"
      },
      "minItems": 0,
      "maxItems": 4096,
      "uniqueItems": true
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 65536
      },
      "minItems": 0,
      "maxItems": 256,
      "uniqueItems": true
    }
  },
  "required": [
    "evidence_paths",
    "findings",
    "log_paths",
    "notes",
    "report_paths"
  ],
  "additionalProperties": false
}
