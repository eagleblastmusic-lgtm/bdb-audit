        },
        "version": {
          "type": "string"
        },
        "revision_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "schema_revision_ref": {
          "type": "object",
          "properties": {
            "schema_id": {
