{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bdb:p0:wire:COMMON/1",
  "$defs": {
    "LogicalId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "TypedRef": {
