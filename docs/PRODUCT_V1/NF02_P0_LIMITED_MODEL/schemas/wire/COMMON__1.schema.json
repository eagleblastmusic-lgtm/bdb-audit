                "urn:bdb:p0:canonical:artifact_contract_registry/2",
                "urn:bdb:p0:canonical:schema_registry/3",
                "urn:bdb:p0:canonical:policy_revision/3",
                "urn:bdb:p0:canonical:spec_revision/3",
                "urn:bdb:p0:canonical:trust_profile/3",
                "urn:bdb:p0:canonical:installation_bootstrap_profile/2",
                "urn:bdb:p0:canonical:nf02_p0_source_snapshot/1",
                "urn:bdb:p0:canonical:campaign_genesis/3",
                "urn:bdb:p0:canonical:attempt/3",
                "urn:bdb:p0:canonical:assignment_manifest/3",
                "urn:bdb:p0:canonical:assignment_package_binding/3",
                "urn:bdb:p0:canonical:nf02_p0_delivery/1",
                "urn:bdb:p0:canonical:lane_result_admission_evidence/4",
                "urn:bdb:p0:canonical:bdb_audit_lane_result/4",
                "urn:bdb:p0:canonical:nf02_p0_abort/1",
                "urn:bdb:p0:canonical:command_envelope/3",
                "urn:bdb:p0:canonical:commit_body/3",
                "urn:bdb:p0:canonical:command_receipt/3"
              ]
            },
            "raw_digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "raw_digest",
            "schema_id"
          ],
          "additionalProperties": false
        },
        "digest_profile": {
          "const": "BDB-OBJECT-DIGEST-1"
        },
        "logical_id": {
          "$ref": "urn:bdb:p0:wire:COMMON/1#/$defs/LogicalId"
        }
      },
      "required": [
        "digest_profile",
        "kind",
        "logical_id",
        "revision_digest",
        "schema_revision_ref",
        "version"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "artifact_contract_registry"
            },
            "version": {
              "const": "2"
            },
            "logical_id": {
              "pattern": "^artifact_contract_registry_"
            },
            "schema_revision_ref": {
              "properties": {
                "schema_id": {
                  "const": "urn:bdb:p0:canonical:artifact_contract_registry/2"
