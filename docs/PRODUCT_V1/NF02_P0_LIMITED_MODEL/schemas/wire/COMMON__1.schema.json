      "properties": {
        "kind": {
          "enum": [
            "artifact_contract_registry",
            "assignment_manifest",
            "assignment_package_binding",
            "attempt",
            "bdb_audit_lane_result",
            "campaign_genesis",
            "command_envelope",
            "command_receipt",
            "commit_body",
            "installation_bootstrap_profile",
            "lane_result_admission_evidence",
            "nf02_p0_abort",
            "nf02_p0_delivery",
            "nf02_p0_source_snapshot",
            "policy_revision",
            "schema_registry",
            "spec_revision",
            "trust_profile"
