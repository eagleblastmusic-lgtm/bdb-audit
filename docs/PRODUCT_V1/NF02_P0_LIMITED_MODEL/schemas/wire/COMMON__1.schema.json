            },
            "logical_id": {
              "pattern": "^nf02_p0_delivery_"
            },
            "schema_revision_ref": {
              "properties": {
                "schema_id": {
                  "const": "urn:bdb:p0:canonical:nf02_p0_delivery/1"
                }
              }
            }
          }
        },
        {
          "properties": {
            "kind": {
              "const": "lane_result_admission_evidence"
            },
            "version": {
              "const": "4"
            },
            "logical_id": {
              "pattern": "^lane_result_admission_evidence_"
            },
            "schema_revision_ref": {
              "properties": {
                "schema_id": {
                  "const": "urn:bdb:p0:canonical:lane_result_admission_evidence/4"
                }
              }
            }
          }
        },
        {
          "properties": {
            "kind": {
              "const": "bdb_audit_lane_result"
            },
            "version": {
              "const": "4"
            },
            "logical_id": {
              "pattern": "^bdb_audit_lane_result_"
            },
            "schema_revision_ref": {
              "properties": {
