    "ProfileRef": {
      "type": "object",
      "properties": {
        "profile_id": {
          "enum": [
            "BDB_CJSON_1",
            "P0_AUTHORIZATION_V1",
            "P0_BOOTSTRAP_SOURCE_V1",
            "P0_EXECUTION_ISOLATION_V1",
            "P0_HISTORY_RECOVERY_V1",
            "P0_PACKAGE_TRANSPORT_V1",
            "P0_RESULT_TRANSPORT_V1"
          ]
        },
        "revision_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "profile_id",
        "revision_digest"
      ],
      "additionalProperties": false
    },
    "RawRef": {
      "type": "object",
      "properties": {
        "raw_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "byte_length": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "media_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "artifact_contract_ref": {
          "$ref": "urn:bdb:p0:wire:COMMON/1#/$defs/ProfileRef"
        }
      },
      "required": [
        "artifact_contract_ref",
        "byte_length",
        "media_type",
        "raw_digest"
      ],
      "additionalProperties": false
    },
    "Head": {
      "type": "object",
      "properties": {
        "campaign_id": {
          "$ref": "urn:bdb:p0:wire:COMMON/1#/$defs/LogicalId"
        },
        "commit_seq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "commit_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "campaign_id",
        "commit_hash",
        "commit_seq"
      ],
      "additionalProperties": false
    },
    "HistoryCut": {
      "type": "object",
      "properties": {
        "head": {
          "$ref": "urn:bdb:p0:wire:COMMON/1#/$defs/Head"
        },
        "policy_ref": {
          "allOf": [
            {
              "$ref": "urn:bdb:p0:wire:COMMON/1#/$defs/TypedRef"
            },
            {
              "properties": {
                "kind": {
                  "enum": [
                    "policy_revision"
                  ]
                }
              }
            }
          ]
        },
        "spec_ref": {
          "allOf": [
            {
              "$ref": "urn:bdb:p0:wire:COMMON/1#/$defs/TypedRef"
            },
            {
              "properties": {
                "kind": {
                  "enum": [
                    "spec_revision"
                  ]
                }
              }
            }
          ]
        },
        "schema_registry_ref": {
          "allOf": [
            {
              "$ref": "urn:bdb:p0:wire:COMMON/1#/$defs/TypedRef"
            },
            {
              "properties": {
                "kind": {
                  "enum": [
                    "schema_registry"
                  ]
                }
              }
            }
          ]
        },
        "source_ref": {
          "allOf": [
            {
              "$ref": "urn:bdb:p0:wire:COMMON/1#/$defs/TypedRef"
            },
            {
              "properties": {
                "kind": {
                  "enum": [
                    "nf02_p0_source_snapshot"
                  ]
                }
              }
            }
          ]
        }
      },
      "required": [
        "head",
        "policy_ref",
        "schema_registry_ref",
        "source_ref",
        "spec_ref"
      ],
      "additionalProperties": false
    },
    "EventId": {
      "type": "object",
      "properties": {
        "commit_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "commit_hash",
        "ordinal"
      ],
      "additionalProperties": false
    },
    "FileEntry": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^[A-Za-z0-9_-]+(?:[.][A-Za-z0-9_-]+)*(?:/[A-Za-z0-9_-]+(?:[.][A-Za-z0-9_-]+)*)*$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "bytes",
        "file",
        "sha256"
      ],
      "additionalProperties": false
    },
    "Member": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^[A-Za-z0-9_-]+(?:[.][A-Za-z0-9_-]+)*(?:/[A-Za-z0-9_-]+(?:[.][A-Za-z0-9_-]+)*)*$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "media_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "bytes",
        "media_type",
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "State": {
      "enum": [
        "ASSIGNED",
        "BOUND",
        "STARTED",
        "DELIVERED",
        "EVIDENCE_ACCEPTED",
        "RESULT_ACCEPTED",
        "ABORTED"
      ]
    },
    "Event": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "event_type": {
              "const": "P0FactAccepted"
            },
            "artifact_ref": {
              "allOf": [
                {
                  "$ref": "urn:bdb:p0:wire:COMMON/1#/$defs/TypedRef"
                },
                {
                  "properties": {
                    "kind": {
                      "enum": [
                        "artifact_contract_registry",
                        "schema_registry",
                        "policy_revision",
                        "spec_revision",
                        "trust_profile",
                        "installation_bootstrap_profile",
                        "nf02_p0_source_snapshot",
                        "campaign_genesis",
                        "attempt",
                        "assignment_manifest",
                        "assignment_package_binding",
                        "nf02_p0_delivery",
                        "lane_result_admission_evidence",
                        "bdb_audit_lane_result",
                        "nf02_p0_abort"
                      ]
                    }
                  }
                }
              ]
            }
          },
          "required": [
            "artifact_ref",
            "event_type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "event_type": {
              "const": "P0AttemptStarted"
            },
            "attempt_ref": {
              "allOf": [
                {
                  "$ref": "urn:bdb:p0:wire:COMMON/1#/$defs/TypedRef"
                },
                {
                  "properties": {
                    "kind": {
                      "enum": [
                        "attempt"
                      ]
                    }
                  }
                }
              ]
            },
            "assignment_ref": {
              "allOf": [
                {
                  "$ref": "urn:bdb:p0:wire:COMMON/1#/$defs/TypedRef"
                },
                {
                  "properties": {
                    "kind": {
                      "enum": [
                        "assignment_manifest"
                      ]
                    }
                  }
                }
              ]
            },
            "binding_ref": {
              "allOf": [
                {
                  "$ref": "urn:bdb:p0:wire:COMMON/1#/$defs/TypedRef"
                },
                {
                  "properties": {
                    "kind": {
                      "enum": [
                        "assignment_package_binding"
                      ]
                    }
                  }
                }
              ]
            }
          },
          "required": [
            "assignment_ref",
            "attempt_ref",
            "binding_ref",
            "event_type"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "not": {}
}
