{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bdb:p0:wire:RESULT_MANIFEST/1",
  "type": "object",
  "properties": {
    "scope": {
      "type": "object",
      "properties": {
        "campaign_id": {
          "$ref": "urn:bdb:p0:wire:COMMON/1#/$defs/LogicalId"
        },
        "attempt_ref": {
          "allOf": [
            {
              "$ref": "urn:bdb:p0:wire:COMMON/1#/$defs/TypedRef"
            },
            {
              "properties": {
                "kind": {
                  "enum": [
                    "attempt"
                  ]
                }
              }
            }
          ]
        },
        "assignment_ref": {
          "allOf": [
            {
              "$ref": "urn:bdb:p0:wire:COMMON/1#/$defs/TypedRef"
            },
            {
              "properties": {
                "kind": {
                  "enum": [
                    "assignment_manifest"
                  ]
                }
              }
            }
          ]
        },
        "source_ref": {
          "allOf": [
            {
              "$ref": "urn:bdb:p0:wire:COMMON/1#/$defs/TypedRef"
            },
            {
              "properties": {
                "kind": {
                  "enum": [
                    "nf02_p0_source_snapshot"
                  ]
                }
              }
            }
          ]
        },
        "slot_id": {
          "const": "EXTERNAL_AUDIT_RESULT"
        }
      },
      "required": [
        "assignment_ref",
        "attempt_ref",
        "campaign_id",
        "slot_id",
        "source_ref"
      ],
      "additionalProperties": false
    },
    "binding_ref": {
      "allOf": [
        {
          "$ref": "urn:bdb:p0:wire:COMMON/1#/$defs/TypedRef"
        },
        {
          "properties": {
            "kind": {
              "enum": [
                "assignment_package_binding"
              ]
            }
          }
        }
      ]
    },
    "delivery_ref": {
      "allOf": [
        {
          "$ref": "urn:bdb:p0:wire:COMMON/1#/$defs/TypedRef"
        },
        {
          "properties": {
            "kind": {
              "enum": [
                "nf02_p0_delivery"
              ]
            }
          }
        }
      ]
    },
    "package_raw_ref": {
      "allOf": [
        {
          "$ref": "urn:bdb:p0:wire:COMMON/1#/$defs/RawRef"
        },
        {
          "properties": {
            "media_type": {
              "const": "application/zip"
            },
            "artifact_contract_ref": {
              "allOf": [
                {
                  "$ref": "urn:bdb:p0:wire:COMMON/1#/$defs/ProfileRef"
                },
                {
                  "properties": {
                    "profile_id": {
                      "const": "P0_PACKAGE_TRANSPORT_V1"
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "members": {
      "type": "array",
      "items": {
        "$ref": "urn:bdb:p0:wire:COMMON/1#/$defs/Member"
      },
      "minItems": 1,
      "maxItems": 4096,
      "uniqueItems": true
    },
    "payload": {
      "type": "object",
      "properties": {
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "finding_id": {
                "$ref": "urn:bdb:p0:wire:COMMON/1#/$defs/LogicalId"
              },
              "severity": {
                "enum": [
                  "INFO",
                  "LOW",
                  "MEDIUM",
                  "HIGH",
                  "CRITICAL"
                ]
              },
              "summary": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "details": {
                "type": "string",
                "maxLength": 65536
              },
              "source_paths": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "minItems": 0,
                "maxItems": 4096,
                "uniqueItems": true
              },
              "evidence_paths": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 512,
                  "pattern": "^[A-Za-z0-9_-]+(?:[.][A-Za-z0-9_-]+)*(?:/[A-Za-z0-9_-]+(?:[.][A-Za-z0-9_-]+)*)*$"
                },
                "minItems": 0,
                "maxItems": 4096,
                "uniqueItems": true
              }
            },
            "required": [
              "details",
              "evidence_paths",
              "finding_id",
              "severity",
              "source_paths",
              "summary"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 4096,
          "uniqueItems": true
        },
        "report_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 512,
            "pattern": "^[A-Za-z0-9_-]+(?:[.][A-Za-z0-9_-]+)*(?:/[A-Za-z0-9_-]+(?:[.][A-Za-z0-9_-]+)*)*$"
          },
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true
        },
        "evidence_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 512,
            "pattern": "^[A-Za-z0-9_-]+(?:[.][A-Za-z0-9_-]+)*(?:/[A-Za-z0-9_-]+(?:[.][A-Za-z0-9_-]+)*)*$"
          },
          "minItems": 0,
          "maxItems": 4096,
          "uniqueItems": true
        },
        "log_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 512,
            "pattern": "^[A-Za-z0-9_-]+(?:[.][A-Za-z0-9_-]+)*(?:/[A-Za-z0-9_-]+(?:[.][A-Za-z0-9_-]+)*)*$"
          },
          "minItems": 0,
          "maxItems": 4096,
          "uniqueItems": true
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 65536
          },
          "minItems": 0,
          "maxItems": 256,
          "uniqueItems": true
        }
      },
      "required": [
        "evidence_paths",
        "findings",
        "log_paths",
        "notes",
        "report_paths"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "binding_ref",
    "delivery_ref",
    "members",
    "package_raw_ref",
    "payload",
    "scope"
  ],
  "additionalProperties": false
}
