{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bdb:p0:wire:DELIVERY_ACK/1",
  "type": "object",
  "properties": {
    "domain": {
      "const": "BDB_P0_DELIVERY_ACK/1"
    },
    "scope": {
      "type": "object",
      "properties": {
        "campaign_id": {
          "$ref": "urn:bdb:p0:wire:COMMON/1#/$defs/LogicalId"
        },
        "attempt_ref": {
          "allOf": [
            {
              "$ref": "urn:bdb:p0:wire:COMMON/1#/$defs/TypedRef"
            },
            {
              "properties": {
                "kind": {
                  "enum": [
                    "attempt"
                  ]
                }
              }
            }
          ]
        },
        "assignment_ref": {
          "allOf": [
            {
              "$ref": "urn:bdb:p0:wire:COMMON/1#/$defs/TypedRef"
            },
            {
              "properties": {
                "kind": {
                  "enum": [
                    "assignment_manifest"
                  ]
                }
              }
            }
          ]
        },
        "source_ref": {
          "allOf": [
            {
              "$ref": "urn:bdb:p0:wire:COMMON/1#/$defs/TypedRef"
            },
            {
              "properties": {
                "kind": {
                  "enum": [
                    "nf02_p0_source_snapshot"
                  ]
                }
              }
            }
          ]
        },
        "slot_id": {
          "const": "EXTERNAL_AUDIT_RESULT"
        }
      },
      "required": [
        "assignment_ref",
        "attempt_ref",
        "campaign_id",
        "slot_id",
        "source_ref"
      ],
      "additionalProperties": false
    },
    "release_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "binding_ref": {
      "allOf": [
        {
          "$ref": "urn:bdb:p0:wire:COMMON/1#/$defs/TypedRef"
        },
        {
          "properties": {
            "kind": {
              "enum": [
                "assignment_package_binding"
              ]
            }
          }
        }
      ]
    },
    "start_event": {
      "$ref": "urn:bdb:p0:wire:COMMON/1#/$defs/EventId"
    },
    "package_raw_ref": {
      "allOf": [
        {
          "$ref": "urn:bdb:p0:wire:COMMON/1#/$defs/RawRef"
        },
        {
          "properties": {
            "media_type": {
              "const": "application/zip"
            },
            "artifact_contract_ref": {
              "allOf": [
                {
                  "$ref": "urn:bdb:p0:wire:COMMON/1#/$defs/ProfileRef"
                },
                {
                  "properties": {
                    "profile_id": {
                      "const": "P0_PACKAGE_TRANSPORT_V1"
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "auditor_certificate_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "auditor_certificate_sha256",
    "binding_ref",
    "domain",
    "package_raw_ref",
    "release_id",
    "scope",
    "start_event"
  ],
  "additionalProperties": false
}
